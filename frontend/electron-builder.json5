// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.risheekesh.lyfo",
  "productName": "Lyf-O",
  "asar": true,
  "directories": {
    "output": "release/${version}",
    "buildResources": "build"
  },
  "files": [
    "dist",
    "dist-electron"
  ],

  // The PyInstaller bundle is copied in verbatim; main.ts spawns it from
  // process.resourcesPath/backend. Build it first:
  //   cd backend && ./venv/bin/python -m PyInstaller lyfo-backend.spec --noconfirm
  // PyInstaller cannot cross-compile — build on each target OS.
  "extraResources": [
    {
      "from": "../backend/dist/lyfo-backend",
      "to": "backend",
      "filter": ["**/*"]
    }
  ],

  "mac": {
    "target": [
      { "target": "dmg", "arch": ["arm64", "x64"] }
    ],
    "category": "public.app-category.productivity",
    "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
    // The bundled Python binary is unsigned; without this the hardened runtime
    // refuses to execute it.
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  },

  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}"
  },

  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },

  "linux": {
    "target": ["AppImage"],
    "category": "Office",
    "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
  }
}
